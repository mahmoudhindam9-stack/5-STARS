{
  "name": "five-stars-pos",
  "version": "1.0.1",
  "description": "Five Stars Electrical Supplies POS System",
  "main": "electron/main.js",
  "scripts": {
    "build": "echo Static app ready",
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.fivestars.pos",
    "productName": "Five Stars",
    "artifactName": "Five Stars SETUP.exe",
    "asar": true,
    "compression": "maximum",
    "directories": { "output": "dist-installer" },
    "files": [
      "electron/**/*",
      "index.html",
      "app.js",
      "accounts-print.js",
      "returns.js",
      "styles.css",
      "pos.css",
      "shell*.html",
      "shell*.js",
      "sync*.js",
      "sw.js",
      "metadata.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Five Stars",
      "runAfterFinish": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "uninstallDisplayName": "Five Stars - Uninstall"
    }
  }
}
