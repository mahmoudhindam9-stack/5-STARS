{
  "name": "five-stars-pos",
  "version": "1.0.0",
  "description": "Five Stars Electrical Supplies POS System",
  "main": "electron/main.js",
  "scripts": {
    "build": "echo Static app ready",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.fivestars.pos",
    "productName": "Five Stars",
    "artifactName": "Five Stars SETUP.exe",
    "asar": true,
    "directories": { "output": "dist-installer" },
    "files": [
      "**/*",
      "!dist-installer{,/**/*}",
      "!node_modules/.cache{,/**/*}"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Five Stars",
      "runAfterFinish": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    }
  }
}
